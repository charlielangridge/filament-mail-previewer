{
    "name": "charlielangridge/filament-mail-previewer",
    "description": "Filament Mail Previewer - allows you to preview mailables and notifications in Filament",
    "keywords": [
        "charlielangridge",
        "laravel",
        "filamentphp",
        "filament",
        "filament-plugin",
        "filament-mail-previewer"
    ],
    "homepage": "https://github.com/charlielangridge/filament-mail-previewer",
    "support": {
        "issues": "https://github.com/charlielangridge/filament-mail-previewer/issues",
        "source": "https://github.com/charlielangridge/filament-mail-previewer"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Charlie Langridge",
            "email": "charlie@charlielangridge.com",
            "role": "Developer"
        }
    ],
    "require": {
        "charlielangridge/laravel-mail-previewer": "^0.1.0",
        "php": "^8.2",
        "filament/filament": "^5.0",
        "spatie/laravel-package-tools": "^1.15.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^9.0|^10.0",
        "pestphp/pest": "^3.7|^4.0",
        "pestphp/pest-plugin-arch": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "pestphp/pest-plugin-livewire": "^3.0|^4.0",
        "rector/rector": "^2.0",
        "spatie/laravel-ray": "^1.26"
    },
    "autoload": {
        "psr-4": {
            "CharlieLangridge\\FilamentMailPreviewer\\": "src/",
            "CharlieLangridge\\FilamentMailPreviewer\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CharlieLangridge\\FilamentMailPreviewer\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "analyse": "phpstan analyse",
        "lint": "pint",
        "refactor": "rector",
        "test": "pest",
        "test:lint": "pint --test",
        "test:refactor": "rector --dry-run"
    },
    "extra": {
        "laravel": {
            "providers": [
                "CharlieLangridge\\FilamentMailPreviewer\\FilamentMailPreviewerServiceProvider"
            ],
            "aliases": {
                "FilamentMailPreviewer": "CharlieLangridge\\FilamentMailPreviewer\\Facades\\FilamentMailPreviewer"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
